# ---------------------------------------------------------------------------
# Frangrant Aura — environment variables
# Copy this file to `.env.local` and fill in your own values.
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# ---------------------------------------------------------------------------

# Paystack PUBLIC key (safe to expose). Starts with pk_test_ or pk_live_.
# The SECRET key must never be added here — it stays on your server only.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The currency Paystack should charge in.
NEXT_PUBLIC_STORE_CURRENCY=NGN

# WhatsApp number for order enquiries, in international format with no
# spaces, plus signs or brackets. Example: 2348012345678
NEXT_PUBLIC_WHATSAPP_NUMBER=2348000000000

# Business details used in checkout metadata and the Paystack popup.
NEXT_PUBLIC_STORE_NAME="Frangrant Aura"
NEXT_PUBLIC_STORE_EMAIL=hello@frangrantaura.com

# Absolute URL of the deployed site (used for sitemap + canonical links).
NEXT_PUBLIC_SITE_URL=https://frangrantaura.vercel.app
